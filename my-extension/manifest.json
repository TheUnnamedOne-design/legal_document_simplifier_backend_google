{
  "manifest_version": 3,
  "name": "Legal PDF Summarizer",
  "version": "1.0",
  "description": "Summarize legal PDFs and open advanced features on website",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
  "file:///*",
  "http://localhost:5000/*",
  "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
