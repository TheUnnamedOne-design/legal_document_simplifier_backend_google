{
  "manifest_version": 3,
  "name": "Mistral Fact Checker",
  "version": "1.1.0",
  "permissions": ["contextMenus", "scripting", "activeTab", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
